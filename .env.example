# Web3Forms access key (https://web3forms.com). It is public by design: it can
# only deliver messages to the mailbox it was created for.
# Leave empty to hide the form and keep the mailto contact only.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Production origin, used for canonical URL, sitemap and Open Graph.
# Leave empty until the final domain is confirmed.
NEXT_PUBLIC_SITE_URL=
